{
  "name": "dsh-humanizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run build -w @dsh/writing-core && npm run build -w @dsh/humanizer && npm run build -w @dsh/voice",
    "test": "node --experimental-strip-types --test \"packages/writing-core/test/**/*.test.ts\""
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
